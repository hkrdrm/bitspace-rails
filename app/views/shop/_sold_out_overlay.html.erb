<%# Covers a product image when nothing is left in any size or colour. The
    parent image box must be `relative`. %>
<div class="absolute inset-0 flex items-center justify-center bg-white/60" data-sold-out-overlay>
  <span class="-rotate-6 border-4 border-brand-orange bg-white px-5 py-2 font-display text-3xl uppercase tracking-wide text-brand-orange shadow-lg">Sold out</span>
</div>
