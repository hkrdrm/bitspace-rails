<div class="bg-white text-ink">
  <%= render "shared/page_header",
        heading_top: "THE",
        heading_bottom: "SHOP.",
        lede: "Small batch shirts, printed in McComb." %>

  <section class="max-w-7xl mx-auto px-6 py-12">
    <% if @products.empty? %>
      <%= render "shared/empty_state", message: "Nothing in the shop just yet. Check back soon." %>
    <% else %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @products.each do |product| %>
          <%= link_to shop_product_path(product.slug), class: "group block border-2 border-brand-green rounded-xl overflow-hidden" do %>
            <div class="aspect-square bg-gray-100 flex items-center justify-center overflow-hidden">
              <%= product_image_tag product, alt: product.name, class: "w-full h-full object-cover group-hover:scale-105 transition-transform" %>
            </div>
            <div class="p-5">
              <h2 class="font-display text-2xl tracking-tight"><%= product.name %></h2>
              <p class="mt-1 font-bold text-sm"><%= price_label(product) %></p>
              <% swatch_option = product.swatch_option %>
              <% swatches = swatch_option ? swatch_option.option_values.select(&:swatch?) : [] %>
              <% if swatches.many? %>
                <div class="mt-3 flex items-center gap-2">
                  <% swatches.each do |value| %>
                    <span title="<%= value.name %>"><%= render "shared/swatch", value: value %></span>
                  <% end %>
                  <span class="text-xs text-gray-500"><%= pluralize(swatches.size, swatch_option.name.downcase) %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
