<%
  picker_data = if @product.simple?
    {}
  else
    {
      controller: "variant-picker",
      variant_picker_variants_value: variant_picker_variants(@product).to_json,
      variant_picker_images_value: variant_picker_images(@product).to_json,
      variant_picker_from_value: price_label(@product)
    }
  end
%>
<div class="bg-white text-ink">
  <%= render "shared/page_header", heading_top: @product.name, heading_bottom: "#{price_label(@product)}." %>

  <%= tag.section class: "max-w-5xl mx-auto px-6 py-12 grid md:grid-cols-2 gap-10", data: picker_data do %>
    <div class="relative aspect-square bg-gray-100 rounded-xl overflow-hidden flex items-center justify-center">
      <%= product_image_tag @product, alt: @product.name, class: "w-full h-full object-cover", data: { variant_picker_target: "image" } %>
      <%= render "sold_out_overlay" unless @product.in_stock? %>
    </div>

    <div>
      <p class="text-gray-700"><%= @product.description %></p>

      <% if @product.simple? %>
        <% sold_out = @product.variants.none? || @product.variants.first.sold_out? %>
        <p class="mt-8 text-xs font-bold uppercase tracking-widest <%= "text-gray-400" if sold_out %>"
           data-simple-stock <%= "data-sold-out" if sold_out %>><%= sold_out ? "Sold out" : "In stock" %></p>
      <% else %>
        <div class="mt-8 hidden space-y-6" data-variant-picker-target="picker">
          <% @product.options.each do |option| %>
            <% values = option.option_values %>
            <div>
              <p id="option-<%= option.id %>-label" class="text-xs font-bold uppercase tracking-widest text-gray-500"><%= option.name %></p>
              <% if values.one? %>
                <p class="mt-2 flex items-center gap-2 text-sm font-bold"
                   data-variant-picker-target="fixed" data-option-id="<%= option.id %>" data-value-id="<%= values.first.id %>">
                  <%= render("shared/swatch", value: values.first) if values.first.swatch? %>
                  <span><%= values.first.name %></span>
                </p>
              <% else %>
                <div class="mt-2 flex flex-wrap gap-2" role="group" aria-labelledby="option-<%= option.id %>-label">
                  <% values.each do |value| %>
                    <button type="button" aria-pressed="false"
                            data-variant-picker-target="button" data-action="variant-picker#choose"
                            data-option-id="<%= option.id %>" data-value-id="<%= value.id %>"
                            class="flex items-center gap-2 px-3 py-2 border-2 border-gray-200 rounded-lg text-sm font-bold"><%= render("shared/swatch", value: value) if value.swatch? %><%= value.name %><span class="sr-only" data-availability></span></button>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <div class="flex items-baseline justify-between gap-4 border-t-2 border-gray-200 pt-4" aria-live="polite">
            <span class="font-display text-2xl" data-variant-picker-target="price"></span>
            <span class="text-xs font-bold uppercase tracking-widest" data-variant-picker-target="status"></span>
          </div>
        </div>

        <ul class="mt-8 space-y-2" data-variant-list data-variant-picker-target="list">
          <% @product.variants.each do |variant| %>
            <li class="flex items-center justify-between gap-4 text-sm py-2 border-b border-gray-200 <%= "text-gray-400" if variant.sold_out? %>"
                data-variant-id="<%= variant.id %>" <%= "data-sold-out" if variant.sold_out? %>>
              <span class="font-bold <%= "line-through" if variant.sold_out? %>"><%= variant.label %></span>
              <span class="<%= "line-through" if variant.sold_out? %>"><%= price(variant.price_cents) %></span>
              <span class="text-xs uppercase tracking-widest"><%= variant.sold_out? ? "Sold out" : "In stock" %></span>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if @product.in_stock? %>
        <%= form_with url: cart_items_path, class: "mt-8 space-y-4" do %>
          <% if @product.simple? %>
            <input type="hidden" name="variant_id" value="<%= @product.variants.first.id %>">
          <% else %>
            <%# Without JavaScript this select is the picker; with it, the picker fills it in. %>
            <div data-variant-picker-target="choice">
              <label for="variant_id" class="text-xs font-bold uppercase tracking-widest text-gray-500">Choose</label>
              <select id="variant_id" name="variant_id" required data-variant-picker-target="select"
                      class="mt-2 w-full px-3 py-2 text-sm text-ink bg-white border-2 border-gray-300 rounded-md">
                <option value="">Choose an option</option>
                <% @product.variants.reject(&:sold_out?).each do |variant| %>
                  <option value="<%= variant.id %>"><%= variant.label %> — <%= price(variant.price_cents) %></option>
                <% end %>
              </select>
            </div>
          <% end %>
          <div class="flex items-end gap-4">
            <div>
              <label for="quantity" class="text-xs font-bold uppercase tracking-widest text-gray-500">Quantity</label>
              <input id="quantity" type="number" name="quantity" value="1" min="1" max="<%= Cart::MAX_QUANTITY %>"
                     class="mt-2 w-20 px-2 py-2 text-sm text-ink bg-white border-2 border-gray-300 rounded-md">
            </div>
            <button type="submit" data-variant-picker-target="submit"
                    class="inline-flex items-center gap-2 bg-brand-green hover:bg-brand-green-dark disabled:opacity-50 text-white font-bold text-sm tracking-wide uppercase px-6 py-3 rounded">Add to cart</button>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
