<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bitspace Studio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"> %>
    <%# <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"> %>
    <%# <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"> %>
    <%# <link rel="manifest" href="/site.webmanifest"> %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%= render partial: "layouts/partials/navigation" %>

  <body class="flex flex-col bg-gray-900 text-white min-h-screen">
    <% if notice %>
      <div class="alert alert-success"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="alert alert-danger"><%= alert %></div>
    <% end %>

    <div class="mb-auto">
      <%= yield %>
    </div>

    <footer class="bg-ink text-white border-t-4 border-brand-green bg-cover bg-center" style="background-image: url('<%= image_path('footer_background.png') %>')">
      <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex flex-col items-center md:items-start gap-2 shrink-0">
          <div class="font-display text-2xl tracking-wide flex items-center">
            <span class="text-brand-green">BIT</span><span class="inline-block w-2.5 h-2.5 rounded-full bg-brand-orange mx-1"></span><span>SPACE</span>
          </div>
        </div>

        <div class="flex flex-col items-center gap-3 shrink-0">
          <div class="text-xs font-bold tracking-widest uppercase text-gray-300">Let&rsquo;s print something great.</div>
          <%= link_to "#", class: "inline-flex items-center gap-2 bg-brand-green hover:bg-brand-green-dark text-white font-bold text-sm tracking-wide uppercase px-4 py-2 rounded" do %>
            Get a Quote <span aria-hidden="true">&rarr;</span>
          <% end %>
        </div>

        <div class="flex flex-row items-center gap-4 shrink-0">
          <%= image_tag("Facebook_Logo_Primary.png", style: 'height:36px; width:36px;', class: "rounded-full") %>
          <%= image_tag("Instagram_Glyph_Gradient.png", style: 'height:36px; width:36px;', class: "rounded-full") %>
          <%= image_tag("TikTok_Icon_Black_Circle.png", style: 'height:36px; width:36px;', class: "rounded-full") %>
        </div>
      </div>
    </footer>
  </body>
</html>
