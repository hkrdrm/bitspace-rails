<%= render layout: "shared/auth_page", locals: {
      heading_top: "RESET YOUR",
      heading_bottom: "PASSWORD."
    } do %>
  <%= form_with url: rodauth.reset_password_request_path, method: :post, data: { turbo: false }, class: "w-full" do |form| %>
    <div class="mb-6 text-sm text-gray-700">
      <%== rodauth.reset_password_explanatory_text %>
    </div>

    <% if params[rodauth.login_param] && !rodauth.field_error(rodauth.login_param) %>
      <%= form.hidden_field rodauth.login_param, value: params[rodauth.login_param] %>
    <% else %>
      <%= render "shared/auth_field", form: form, param: rodauth.login_param, id: "login",
            label: rodauth.login_label, type: :email, value: params[rodauth.login_param],
            autocomplete: "email", error: rodauth.field_error(rodauth.login_param) %>
    <% end %>

    <%= render "shared/auth_submit", form: form, text: rodauth.reset_password_request_button %>
  <% end %>
<% end %>
