<% unless rodauth.login_form_footer_links.empty? %>
  <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
    <% rodauth.login_form_footer_links.sort.each do |_, link, text| %>
      <li>
        <%= link_to text, link, class: "font-bold text-sm tracking-wide uppercase underline decoration-2 underline-offset-4 text-brand-green hover:text-brand-green-dark rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-green" %>
      </li>
    <% end %>
  </ul>
<% end %>
