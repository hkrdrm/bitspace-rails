<%= render layout: "shared/auth_page", locals: {
      heading_top: "JOIN",
      heading_bottom: "BITSPACE.",
      lede: "Create an account to track your orders and artwork."
    } do %>
  <%= form_with url: rodauth.create_account_path, method: :post, data: { turbo: false }, class: "w-full" do |form| %>
    <%= render "shared/auth_field", form: form, param: rodauth.login_param, id: "login",
          label: rodauth.login_label, type: :email, value: params[rodauth.login_param],
          autocomplete: "email", error: rodauth.field_error(rodauth.login_param) %>

    <% if rodauth.require_login_confirmation? %>
      <%= render "shared/auth_field", form: form, param: rodauth.login_confirm_param, id: "login-confirm",
            label: rodauth.login_confirm_label, type: :email, value: params[rodauth.login_confirm_param],
            autocomplete: "email", error: rodauth.field_error(rodauth.login_confirm_param) %>
    <% end %>

    <% if rodauth.create_account_set_password? %>
      <%= render "shared/auth_field", form: form, param: rodauth.password_param, id: "password",
            label: rodauth.password_label, type: :password, value: "",
            autocomplete: rodauth.password_field_autocomplete_value,
            error: rodauth.field_error(rodauth.password_param) %>

      <% if rodauth.require_password_confirmation? %>
        <%= render "shared/auth_field", form: form, param: rodauth.password_confirm_param, id: "password-confirm",
              label: rodauth.password_confirm_label, type: :password, value: "",
              autocomplete: "new-password", error: rodauth.field_error(rodauth.password_confirm_param) %>
      <% end %>
    <% end %>

    <%= render "shared/auth_submit", form: form, text: rodauth.create_account_button %>
  <% end %>
<% end %>
