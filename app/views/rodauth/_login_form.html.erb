<%= form_with url: rodauth.login_path, method: :post, data: { turbo: false }, class: "w-full" do |form| %>
  <% if rodauth.skip_login_field_on_login? %>
    <%= render "shared/auth_field", form: form, param: rodauth.login_param, id: "login",
          label: rodauth.login_label, type: :email, value: params[rodauth.login_param], readonly: true %>
  <% else %>
    <%= render "shared/auth_field", form: form, param: rodauth.login_param, id: "login",
          label: rodauth.login_label, type: :email, value: params[rodauth.login_param],
          autocomplete: rodauth.login_field_autocomplete_value,
          error: rodauth.field_error(rodauth.login_param) %>
  <% end %>

  <% unless rodauth.skip_password_field_on_login? %>
    <%= render "shared/auth_field", form: form, param: rodauth.password_param, id: "password",
          label: rodauth.password_label, type: :password, value: "",
          autocomplete: rodauth.password_field_autocomplete_value,
          error: rodauth.field_error(rodauth.password_param) %>
  <% end %>

  <%= render "shared/auth_submit", form: form, text: rodauth.login_button %>
<% end %>
