<%
  error        = local_assigns[:error]
  type         = local_assigns.fetch(:type, :email)
  value        = local_assigns[:value]
  autocomplete = local_assigns[:autocomplete]
  readonly     = local_assigns.fetch(:readonly, false)

  field_classes = if readonly
    "mt-2 w-full py-2 px-0 text-sm bg-inherit border-transparent focus:ring-0 focus:border-transparent"
  else
    state = if error
      "border-brand-orange focus:border-brand-orange focus:ring-brand-orange/40"
    else
      "border-gray-300 focus:border-brand-green focus:ring-brand-green/40"
    end
    "mt-2 w-full px-3 py-2 text-sm text-ink bg-white border-2 rounded-md focus:outline-none focus:ring-2 #{state}"
  end
%>
<div class="mb-6">
  <%= form.label id, label, class: "block text-xs font-bold uppercase tracking-widest text-gray-500" %>

  <%= form.send("#{type}_field", param,
        value: value,
        id: id,
        autocomplete: autocomplete,
        required: !readonly,
        readonly: readonly,
        class: field_classes,
        aria: ({ invalid: true, describedby: "#{id}_error_message" } if error)) %>

  <% if error %>
    <span class="block mt-2 text-xs font-bold text-brand-orange" id="<%= id %>_error_message"><%= error %></span>
  <% end %>
</div>
