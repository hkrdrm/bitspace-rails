#!/usr/bin/env bash
# Runs on the production server after the new code is checked out.
# CI calls it over SSH (see .github/workflows/ci.yml); you can also run it by hand.
set -euo pipefail

PUMA_SERVICE="${PUMA_SERVICE:-puma-bitspace-rails}"
export RAILS_ENV=production

cd "$(dirname "$0")/.."

# Non-interactive SSH sessions skip shell rc files, so load rbenv explicitly.
if [ -d "$HOME/.rbenv" ]; then
  export PATH="$HOME/.rbenv/bin:$HOME/.rbenv/shims:$PATH"
fi

echo "== Deploying $(git rev-parse --short HEAD) =="

# Production env vars live in .env and are loaded by the dotenv CLI (same as the
# systemd unit), so the dotenv gem's group must stay installed.
echo "== Installing gems =="
bundle install --quiet

echo "== Migrating database =="
bundle exec dotenv -f .env bin/rails db:migrate

echo "== Precompiling assets =="
bundle exec dotenv -f .env bin/rails assets:precompile

echo "== Restarting $PUMA_SERVICE =="
sudo systemctl restart "$PUMA_SERVICE"

sleep 3
if ! systemctl is-active --quiet "$PUMA_SERVICE"; then
  echo "!! $PUMA_SERVICE failed to start"
  sudo journalctl -u "$PUMA_SERVICE" -n 30 --no-pager
  exit 1
fi

echo "== Deployed =="
